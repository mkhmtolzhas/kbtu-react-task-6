# Firebase Web App configuration.
# Firebase console → Project settings → General → Your apps → SDK setup and configuration.
#
# 1. cp .env.example .env.local
# 2. replace every placeholder with the value from the console
# 3. restart the dev server (Vite reads env files only at startup)
#
# Vite exposes to the browser bundle only variables prefixed with VITE_.
# These values are public by design (they identify the project, they do not
# grant access); access is controlled by Firebase rules and authorized domains.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
